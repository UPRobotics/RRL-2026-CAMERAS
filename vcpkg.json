{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "rtsp-camera-viewer",
  "version": "1.0.0",
  "description": "Ultra-low latency RTSP multi-camera viewer",
  "homepage": "https://github.com/yourusername/RRL-2026-CAMERAS",
  "license": "MIT",
  "dependencies": [
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "swscale",
        "swresample"
      ]
    },
    "sdl2",
    "spdlog",
    "nlohmann-json",
    "concurrentqueue"
  ]
}
